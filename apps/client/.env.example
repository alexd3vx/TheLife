# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# The anon key is public by design; never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Address of the game server (Fly.io), e.g. wss://thelife-server.fly.dev. Leave empty to use ws://<this host>:8787.
VITE_SERVER_URL=
